{
    "name": "mia",
    "displayName": "MIA - AI Code Assistant",
    "description": "Intelligent AI-powered code assistant with autocompletion, hover explanations, and chat. Supports C, Java, and more.",
    "version": "0.1.0",
    "preview": true,
    "serverInfo": {
        "name": "MIA",
        "module": "mia"
    },
    "publisher": "misa-dev",
    "license": "MIT",
    "homepage": "https://github.com/misa-dev/mia-extension",
    "repository": {
        "type": "git",
        "url": "https://github.com/misa-dev/mia-extension.git"
    },
    "bugs": {
        "url": "https://github.com/misa-dev/mia-extension/issues"
    },
    "galleryBanner": {
        "color": "#6B46C1",
        "theme": "dark"
    },
    "keywords": [
        "ai",
        "assistant",
        "copilot",
        "code completion",
        "hover",
        "chat",
        "c",
        "java",
        "python",
        "mia"
    ],
    "engines": {
        "vscode": "^1.78.0"
    },
    "categories": [
        "Programming Languages",
        "Machine Learning",
        "Other"
    ],
    "activationEvents": [
        "onLanguage:c",
        "onLanguage:cpp",
        "onLanguage:java",
        "onLanguage:python",
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool source-map --config ./webpack.config.js",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "format-check": "prettier --check 'src/**/*.ts' 'build/**/*.yml' '.github/**/*.yml'",
        "test": "node ./out/test/runTest.js",
        "vsce-package": "vsce package -o mia.vsix"
    },
    "contributes": {
        "configuration": {
            "title": "MIA - AI Code Assistant",
            "properties": {
                "mia.provider": {
                    "type": "string",
                    "default": "azure",
                    "enum": [
                        "azure",
                        "openai",
                        "anthropic",
                        "ollama"
                    ],
                    "enumDescriptions": [
                        "Azure OpenAI Service",
                        "OpenAI API",
                        "Anthropic Claude API",
                        "Ollama (Local)"
                    ],
                    "description": "AI provider to use for code assistance."
                },
                "mia.azure.endpoint": {
                    "type": "string",
                    "default": "",
                    "description": "Azure OpenAI endpoint URL (e.g., https://your-resource.openai.azure.com/)"
                },
                "mia.azure.deploymentName": {
                    "type": "string",
                    "default": "",
                    "description": "Azure OpenAI deployment name"
                },
                "mia.azure.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Azure OpenAI API key (consider using environment variable MIA_AZURE_API_KEY instead)"
                },
                "mia.azure.apiVersion": {
                    "type": "string",
                    "default": "2024-02-15-preview",
                    "description": "Azure OpenAI API version"
                },
                "mia.openai.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "OpenAI API key (consider using environment variable MIA_OPENAI_API_KEY instead)"
                },
                "mia.openai.model": {
                    "type": "string",
                    "default": "gpt-4o",
                    "description": "OpenAI model to use"
                },
                "mia.anthropic.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Anthropic API key (consider using environment variable MIA_ANTHROPIC_API_KEY instead)"
                },
                "mia.anthropic.model": {
                    "type": "string",
                    "default": "claude-sonnet-4-20250514",
                    "description": "Anthropic model to use"
                },
                "mia.ollama.endpoint": {
                    "type": "string",
                    "default": "http://localhost:11434",
                    "description": "Ollama server endpoint"
                },
                "mia.ollama.model": {
                    "type": "string",
                    "default": "codellama",
                    "description": "Ollama model to use"
                },
                "mia.features.completion": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable inline code completion"
                },
                "mia.features.hover": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable hover explanations"
                },
                "mia.features.chat": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable chat panel"
                },
                "mia.completion.maxTokens": {
                    "type": "number",
                    "default": 256,
                    "description": "Maximum tokens for completion responses"
                },
                "mia.hover.maxTokens": {
                    "type": "number",
                    "default": 512,
                    "description": "Maximum tokens for hover explanations"
                },
                "mia.chat.maxTokens": {
                    "type": "number",
                    "default": 2048,
                    "description": "Maximum tokens for chat responses"
                },
                "mia.languages": {
                    "type": "array",
                    "default": [
                        "c",
                        "cpp",
                        "java",
                        "python",
                        "javascript",
                        "typescript"
                    ],
                    "description": "Languages to enable MIA for"
                },
                "mia.showNotifications": {
                    "type": "string",
                    "default": "onError",
                    "enum": [
                        "off",
                        "onError",
                        "onWarning",
                        "always"
                    ],
                    "description": "Controls when notifications are shown"
                },
                "mia.interpreter": {
                    "type": "array",
                    "default": [],
                    "description": "Path to Python interpreter for the LSP server",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "commands": [
            {
                "command": "mia.restart",
                "title": "Restart MIA Server",
                "category": "MIA"
            },
            {
                "command": "mia.openChat",
                "title": "Open Chat Panel",
                "category": "MIA"
            },
            {
                "command": "mia.explainSelection",
                "title": "Explain Selected Code",
                "category": "MIA"
            },
            {
                "command": "mia.generateCode",
                "title": "Generate Code from Comment",
                "category": "MIA"
            },
            {
                "command": "mia.refactorSelection",
                "title": "Refactor Selected Code",
                "category": "MIA"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "mia.explainSelection",
                    "when": "editorHasSelection",
                    "group": "mia@1"
                },
                {
                    "command": "mia.refactorSelection",
                    "when": "editorHasSelection",
                    "group": "mia@2"
                }
            ]
        },
        "keybindings": [
            {
                "command": "mia.openChat",
                "key": "ctrl+shift+m",
                "mac": "cmd+shift+m"
            },
            {
                "command": "mia.explainSelection",
                "key": "ctrl+shift+e",
                "mac": "cmd+shift+e",
                "when": "editorHasSelection"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "mia-sidebar",
                    "title": "MIA",
                    "icon": "resources/mia-icon.svg"
                }
            ]
        },
        "views": {
            "mia-sidebar": [
                {
                    "type": "webview",
                    "id": "mia.chatView",
                    "name": "Chat"
                }
            ]
        }
    },
    "dependencies": {
        "@vscode/python-extension": "^1.0.5",
        "fs-extra": "^11.2.0",
        "vscode-languageclient": "^8.1.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/vscode": "1.78.0",
        "@types/glob": "^8.1.0",
        "@types/node": "20.x",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "@vscode/test-electron": "^2.3.8",
        "@vscode/vsce": "^2.22.0",
        "eslint": "^8.56.0",
        "glob": "^10.3.10",
        "prettier": "^3.7.4",
        "typescript": "^5.3.3",
        "ts-loader": "^9.5.1",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    }
}